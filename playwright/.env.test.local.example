# Playwright e2e — test account config.
#
# COPY ten plik do `.env.test.local` (gitignored) i uzupełnij wartości.
# Hosts (mail.actuna.pl) są publiczne i bezpieczne jako default w helpers.ts
# fallback — TYLKO password jest secret i NIGDY nie commitowany.
#
# Without .env.test.local pure UI tests (np. wave-1-foundation) NADAL działają
# — używają syntetycznego fallback config z hardcoded defaults dla email/hosts.
# .env.test.local jest wymagany TYLKO dla testów potrzebujących real IMAP/SMTP
# round-trip (search, send-via-mailsync, sync engine deltas).

TEST_ACCOUNT_EMAIL=sffsw323@actuna.pl
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_PROVIDER=imap

TEST_IMAP_HOST=mail.actuna.pl
TEST_IMAP_PORT=993

TEST_SMTP_HOST=mail.actuna.pl
TEST_SMTP_PORT=465
